# ══════════════════════════════════════════════════════════════════
# AI Start-up Incubator Simulator — Environment Template
# Copy this file to .env and fill in your values
# ══════════════════════════════════════════════════════════════════

# ── Application ──────────────────────────────────────────────────
DEBUG=true
BYPASS_AUTH=false
ENVIRONMENT=development

# ── LLM Providers — NVIDIA NIM API (required) ────────────────────
# Key 1: Nemotron Ultra + Llama 3.3 70B
NVIDIA_API_KEY_1=
# Key 2: DeepSeek V4 Flash + Qwen3
NVIDIA_API_KEY_2=
# Key 3: Nemotron Nano VL 8B
NVIDIA_API_KEY_3=

NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_PROVIDER=nvidia

# NVIDIA NIM Models (defaults shown — override to change)
NVIDIA_PRIMARY_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_FAST_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_REASONING_MODEL=deepseek-ai/deepseek-v4-flash
NVIDIA_COMPACT_MODEL=qwen/qwen3-next-80b-a3b-instruct
NVIDIA_VISION_MODEL=nvidia/llama-3.1-nemotron-nano-vl-8b-v1

# ── Supabase (required for database) ────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Search Tools (optional) ─────────────────────────────────────
TAVILY_API_KEY=

# ── Redis (optional — caching + task queue) ─────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Rate Limiting ───────────────────────────────────────────────
RATE_LIMIT_RPM=60

# ── Stripe Billing (optional) ───────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# ── Monitoring (optional) ───────────────────────────────────────
SENTRY_DSN=

# ── Webhooks (optional — for Slack/Discord/custom integrations) ──
# Users can configure their own webhook URLs via the Settings page.
# The platform will POST JSON payloads on workflow/simulation completion.

# ── Next.js Frontend ────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8001
NEXT_PUBLIC_BYPASS_AUTH=false
