# ══════════════════════════════════════════════════════════════════
# AI Start-up Incubator Simulator — Environment Template
# Copy this file to .env and fill in your values
# ══════════════════════════════════════════════════════════════════

# ── Application ──────────────────────────────────────────────────
DEBUG=true
ENVIRONMENT=development

# ── LLM Providers (at least one required) ────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
LLM_PROVIDER=openai

# ── Supabase (required for database) ────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Search Tools (optional) ─────────────────────────────────────
TAVILY_API_KEY=

# ── Redis (optional — caching + task queue) ─────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Rate Limiting ───────────────────────────────────────────────
RATE_LIMIT_RPM=60

# ── Stripe Billing (optional) ───────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# ── Monitoring (optional) ───────────────────────────────────────
SENTRY_DSN=

# ── Webhooks (optional — for Slack/Discord/custom integrations) ──
# Users can configure their own webhook URLs via the Settings page.
# The platform will POST JSON payloads on workflow/simulation completion.

# ── Next.js Frontend ────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000
