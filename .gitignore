# ══════════════════════════════════════════════════════════════════
# AI Start-up Incubator Simulator — .gitignore
# ══════════════════════════════════════════════════════════════════

# ── Environment & Secrets ────────────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local

# ── Python ───────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
*.whl
pip-log.txt
pip-delete-this-directory.txt

# Python virtual environments
venv/
.venv/
env/
ENV/
backend/venv/
backend/.venv/

# Python tools
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
*.cover
.hypothesis/

# ── Node.js / Next.js ───────────────────────────────────────────
node_modules/
frontend/node_modules/
.next/
frontend/.next/
out/
frontend/out/
.turbo/
frontend/.turbo/

# Next.js build
frontend/.vercel
.vercel

# NPM / Yarn / PNPM
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
package-lock.json
!frontend/package-lock.json

# ── IDE & Editor ─────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
*.sublime-project
*.sublime-workspace

# ── OS Files ─────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ── Docker ───────────────────────────────────────────────────────
docker-compose.override.yml

# ── Supabase ─────────────────────────────────────────────────────
supabase/.temp/
supabase/.branches/

# ── Logs & Temp ──────────────────────────────────────────────────
*.log
logs/
tmp/
temp/

# ── Output files (generated by agents — optional) ───────────────
# Uncomment if you don't want to track generated outputs
# outputs/

# ── Terraform ────────────────────────────────────────────────────
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# ── Data & Volumes ───────────────────────────────────────────────
infra/docker/prometheus_data/
infra/docker/redis_data/
postgres_data/
